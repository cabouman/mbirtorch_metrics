# run_configs.env — the run-time knobs for the mbirtorch nightly regression, kept at the top
# level so they are easy to find and edit.  The harness sources this through
# tooling/regression/regression.env.  Each run pulls the metrics repo before measuring, so edits
# here propagate to the nightly automatically.

# mbirtorch branches to track (FIRE-ON-CHANGE): each is measured only when its remote tip moves.
# Tracking `main` activates the dashboard's vs-main correctness reference, which tests the branch
# name literally.  Each extra branch adds a worst-night GPU cost.
# Note that the object below is used in a shell script, so strings separated by spaces is correct.
TRACKED_BRANCHES=("main" "prerelease" "greg_dev")

# ── torch CUDA-build selection ────────────────────────────────────────────────────────────────
# torch selects its CUDA build through the WHEEL INDEX rather than through a pip extra.
# mbirtorch's pyproject declares `torch>=2.13` with no CUDA extra, so a plain
# `pip install -e .[test]` resolves whatever the default index serves.  The GPU install therefore
# pre-installs torch from this index, and the editable install then finds torch satisfied.
#
# KEEP IN SYNC WITH THE NODE'S DRIVER, not with the cuda module: the cuNNN wheel bundles its own CUDA
# runtime and cuDNN as pip packages, so NNN's major must be one the driver supports (`nvidia-smi` ->
# "CUDA Version"; 13.2 on gautschi's H100 nodes, 2026-09-03).  The `module load cuda` version in
# PREAMBLE_FILE does not enter into it: verified 2026-09-03 with the modules as loaded, with none,
# and with cuda/13.3.0 (identical; see mbirtorch_plans/.claude/cluster_use.md, "The node preamble").
# A mismatch does not fail loudly at install time.  The engine's platform guard aborts the RUN
# when torch.cuda cannot initialise, so the symptom of a stale index here is an aborted GPU
# night, not silently wrong data.
TORCH_INDEX_URL_gpu="https://download.pytorch.org/whl/cu130"
TORCH_INDEX_URL_cpu=""            # empty = default PyPI index (macOS arm64 wheels live there)

# pip extras for the editable install of each measured branch.  mbirtorch's pyproject defines
# test = pytest, pytest-xdist.  There is no CUDA extra for torch; see TORCH_INDEX_URL above.
INSTALL_EXTRAS="test"

# Python version for the dedicated mbirtorch_regression conda env, used only if the harness has
# to create that env.
CONDA_PYTHON="3.12"

# Highest torch version that has been ASSESSED for a performance change.  mbirtorch declares
# `torch>=2.13` with no upper bound, so any torch release can move the measurements on its own.
# Each nightly checks PyPI and, when a torch newer than this ships, warns in the log and in the
# notify email, together with a headroom line saying whether that version can even install on the
# env's Python.  After reviewing a new release, bump this to it whether it was good or bad; a
# version that was assessed and rejected still belongs here, so the alert fires only past it.
TORCH_LAST_REVIEWED="2.13.0"

# ── Dependency canary ─────────────────────────────────────────────────────────────────────────
# When a torch newer than the last measured one ships, the canary upgrades torch in the shared env
# and re-measures DEP_CANARY_BRANCH, so a dependency-induced performance change is attributed
# rather than only reported.  DEFAULT OFF: it changes the fire logic and adds `_gNNNN` run files.
# Turn it on only deliberately.
DEP_CANARY_ENABLED=0
DEP_CANARY_BRANCH="main"        # a stable, representative branch used as the fixed-code baseline
DEP_FULL_REFRESH_DAYS=14        # every N days, eager-upgrade ALL dependencies and re-measure the
                                # canary branch.  This is a maximum-staleness timer rather than
                                # change detection, and it catches non-torch dependency drift.

# ── Gate knobs (the numeric thresholds live in performance_tracking.Config) ────────────────────
# MEM_GATE_WINDOW: rolling-MIN window in runs for the GPU memory gate.  A window above 1 exists
# to reject a per-run memory transient, and torch's max_memory_allocated does not show one.
# MEASURED 2026-08-08 (H100, parallel/vcd_nonconst at 512x448x384, n=1, five fresh subprocesses):
# spread 0.000%, with min equal to max.  A window of 1 is therefore a single-shot compare with no
# detection lag, which is correct here.  Re-run that ablation at n=2 and n=4 before changing it.
MEM_GATE_WINDOW=1

# Device counts the nightly sweeps.  n>1 applies ONLY at the engine's MULTI_DEVICE_SIZE_LABELS
# cells, which are parallel and cone at 512x448x384 and 1024x1008x992.  The smaller sizes and the
# whole denoiser stay at n=1 regardless of this list.
DEVICE_COUNTS="1 2 4"

# ── macOS scheduling — the local time of day the Mac runs the CPU nightly (launchd path).
# Pick a time the Mac is normally AWAKE.  A scheduled wake from sleep is a dark wake, during
# which launchd will not run a LaunchAgent, so a middle-of-the-night time on a laptop that sleeps
# simply never fires.  10:00 is staggered an hour after the mbirjax Mac run so the two never
# contend for the machine.  Re-run enable_nightly.sh after changing this.
MACOS_NIGHTLY_TIME="10:00"

# ── Cluster (SLURM) scheduling — used by enable_nightly.sh (scrontab) and
# nightly_regression.slurm.  The n in {2, 4} rows need four GPUs, and host RAM scales with GPUs
# on the ai partition.  Fourteen cores per GPU is the required ratio there; never pass --mem,
# because host RAM is fixed at about 126 GB per GPU.  QoS `normal` is what the ai partition
# accepts; `standby` is not.
SLURM_ACCOUNT="bouman"
SLURM_PARTITION="ai"
SLURM_QOS="normal"
SLURM_GPUS_PER_NODE=4
SLURM_NTASKS=56
# Ceiling for a changed-branch night.  MEASURED 2026-08-08: the n=1-only pass took 15m48s.
# Fire-on-change exits in seconds on a no-change night, so the ceiling is idle most nights.
SLURM_WALLTIME="04:00:00"
